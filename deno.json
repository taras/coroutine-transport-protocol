{
  "name": "@effection/durable",
  "version": "0.0.1",
  "exports": "./lib/mod.ts",
  "tasks": {
    "test": "deno test --allow-net --allow-read --allow-env --allow-ffi",
    "check": "deno check lib/mod.ts",
    "typecheck": "deno check lib/**/*.ts test/**/*.ts",
    "demo": "./demo/start.sh",
    "demo:server": "deno run --allow-net --allow-read --allow-env --allow-ffi demo/server.ts",
    "demo:cook": "deno run --allow-net --allow-read --allow-env demo/cook.ts",
    "demo:tail": "deno run --allow-net --allow-read --allow-env demo/tail.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@effection/effection": "jsr:@effection/effection@4.1.0-alpha.5",
    "@effection/effection/experimental": "jsr:@effection/effection@4.1.0-alpha.5/experimental",
    "@durable-streams/client": "npm:@durable-streams/client@0.2.1",
    "@durable-streams/server": "npm:@durable-streams/server@0.2.1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
